# Copy to .env and fill in. Never commit .env.
BOT_TOKEN=123456:your-token-from-BotFather
# Comma-separated modules to load (default: all)
MODULES=admin,welcome,notes,antispam,fun,utility,polls,reminders,ai,growth
# AI module: key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-5-5
